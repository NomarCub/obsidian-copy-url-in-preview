{
  "name": "copy-url-in-preview",
  "version": "1.14.0",
  "description": "Image context menus plugin for Obsidian (https://obsidian.md): Copy to clipboard, Open in default app, Show in system explorer, Reveal file in navigation, Open in new tab, Open in new window, Rename.",
  "main": "main.js",
  "author": "NomarCub",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node esbuild.config.mts",
    "build": "node esbuild.config.mts production",
    "check": "npm run type-check && npm run lint && npm run format && npm audit",
    "type-check": "tsc",
    "lint": "biome lint && eslint",
    "lint:fix": "biome lint --fix && eslint --fix",
    "format": "biome format",
    "format:fix": "biome format --write",
    "version": "node version-bump.mts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "i18next": "^23.11.5",
    "obsidian": "^1.13.1",
    "obsidian-typings": "6.38.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
